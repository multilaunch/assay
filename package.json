{
  "name": "hoodterm",
  "version": "0.1.0",
  "description": "Launch terminal for Robinhood Chain: live pons v2 launch feed, on-chain scoring with reasons, creator-fee forensics, tax-aware entry. Local, open, non-custodial, dry run by default.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hoodterm": "./bin/hoodterm.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli/main.ts",
    "doctor": "tsx src/cli/main.ts doctor",
    "hunt": "tsx src/cli/main.ts hunt",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "viem": "^2.56.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
