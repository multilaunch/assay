# Caddy's environment. Deliberately a separate file from deploy/env.prod: the proxy container
# has no business holding PRIVATE_KEY, and this one can be read by whoever debugs TLS.
#
#   cp deploy/caddy.env.example deploy/caddy.env
#   chmod 600 deploy/caddy.env
#
# Whole-line comments only, same as env.prod.

# The hostname the certificate is issued for. An A (and AAAA, if you have one) record for this
# name must already point at this box before the stack starts, or the ACME challenge fails and
# Caddy backs off for progressively longer.
BOARD_DOMAIN=board.example.com

# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL=you@example.com

# Basic-auth username. Anything; it is not a secret.
BOARD_USER=ops

# bcrypt hash of the password, from:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
# The hash starts with $2a$ and contains $ characters. Docker's env_file does not interpolate,
# so paste it verbatim and do not quote it. (If you ever move this into a compose `environment:`
# block instead, every $ must be doubled to $$.)
BOARD_PASSWORD_HASH=REPLACE_ME

# Source addresses allowed to POST — pause, resume, close a position, edit a rule. Everything the
# page reads is a GET and is not affected. Space-separated; CIDR allowed.
#
# The default when this is unset is 192.0.2.1, a documentation address that is nobody: an
# unconfigured box serves the read-only view and refuses every control action. That is the
# intended failure direction. Set it to your own address only if it is static:
#   BOARD_ADMIN_IPS=203.0.113.7 198.51.100.0/24
# If it is not static, leave this alone and drive the controls through the SSH tunnel
# (docs/DEPLOY.md), which does not pass through Caddy at all.
BOARD_ADMIN_IPS=192.0.2.1

# Where Caddy finds the board.
#   board:4663        the compose stack (service name on the compose network)
#   127.0.0.1:4663    the systemd install, with Caddy on the host
BOARD_UPSTREAM=board:4663
