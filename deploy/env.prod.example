# assay — production environment.
#
#   cp deploy/env.prod.example deploy/env.prod
#   chmod 600 deploy/env.prod
#
# Read by two different things, which is why the format is deliberately boring:
#   * docker compose, as `env_file` on the board service
#   * systemd, as `EnvironmentFile=` for deploy/assay.service
#
# Both accept KEY=VALUE and whole-line `#` comments and neither strips a `#` that appears
# after a value. So: never put a comment on the same line as a value. Do not quote values
# unless the value really contains a space. No interpolation, no `export`.
#
# ------------------------------------------------------------------------------------------------
# THE KEY
# ------------------------------------------------------------------------------------------------
# PRIVATE_KEY is the only secret here and it is a bearer token for money. On a VPS it sits on a
# disk you do not own, on a host whose hypervisor you do not control, next to other people's
# tenants. Anyone with root on the box, a snapshot of the volume, or your provider's console has
# it. There is no configuration in this repository that changes that.
#
# So: use a wallet created for this and funded with SESSION_BUDGET_ETH and nothing more. Do not
# reuse a wallet that holds anything else, do not use a hardware wallet's derived key, and treat
# the key as burned the day the box is decommissioned. The four walls in the engine cap what a bug
# can lose; only the wallet balance caps what a compromise can lose.
#
# Leave it empty for a read-only / dry-run deployment. Everything except live trading works
# without it, and that is the right way to run this the first week.
PRIVATE_KEY=

# ------------------------------------------------------------------------------------------------
# NETWORK
# ------------------------------------------------------------------------------------------------
# Empty = the built-in public pair: publicnode for state, the official RPC for logs.
# Or your own, comma-separated, best first; append #nologs to one that refuses eth_getLogs.
# A VPS shares its egress IP with nobody, unlike a laptop on a coffee-shop NAT, so the public
# endpoints behave better here than they do locally. A paid endpoint is still the upgrade that
# matters most: the engine's whole edge is reading a launch before the tax decays.
RPC_URL=

# Launch detection by subscription. Empty = publicnode's free websocket. "off" = HTTP polling.
RPC_WS_URL=

# Polling interval in ms when the websocket is off or drops.
POLL_MS=300

# The gate in front of the public endpoints. Raise these on a private provider; leaving them at
# the public defaults on a paid endpoint just makes the tool slower than it needs to be.
RPC_MAX_IN_FLIGHT=3
RPC_SPACING_MS=50
RPC_LOGS_SPACING_MS=400

# ------------------------------------------------------------------------------------------------
# ENTRY LIMITS — the three walls that are not the arm prompt
# ------------------------------------------------------------------------------------------------
# ETH spent per entry.
ENTRY_ETH=0.01

# Slippage tolerance in basis points.
SLIPPAGE_BPS=300

# Do not buy while the opening tax for this wallet is above this. 9900 at t=0, ~0 after 3 s.
MAX_OPENING_TAX_BPS=300

# How many positions may be open at once.
MAX_OPEN_POSITIONS=3

# Total ETH entries may consume in one process lifetime, whatever the scores say. This is the
# number the wallet balance should match. Restarting the container resets the counter — a crash
# loop on a live board is therefore a way to spend more than this, which is one more reason the
# wallet, not the config, is the real limit.
SESSION_BUDGET_ETH=0.05

# ------------------------------------------------------------------------------------------------
# EXITS
# ------------------------------------------------------------------------------------------------
TAKE_PROFIT_PCT=80
STOP_LOSS_PCT=35
TRAILING_PCT=25
MAX_HOLD_MIN=45

# ------------------------------------------------------------------------------------------------
# ALERTS (optional)
# ------------------------------------------------------------------------------------------------
# On a headless box these are how you find out a position opened without watching the page.
# The bot token is a secret too; the same 0600 applies.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------------------------
# BOARD
# ------------------------------------------------------------------------------------------------
# The port inside the container / inside the systemd unit. The command line in compose.prod.yaml
# and in assay.service passes --port and --host explicitly, so this is a fallback.
BOARD_PORT=4663

# Only consulted when --host is not on the command line, and both compose.prod.yaml and
# assay.service pass it explicitly — so this is a fallback, not the setting in effect.
# Under Docker the board binds 0.0.0.0 inside its own network namespace and the publish is
# 127.0.0.1-only. Under systemd there is no namespace, so leave this at 127.0.0.1 and let Caddy
# reach it over loopback. Setting it to 0.0.0.0 on a systemd box would put the control surface on
# the public internet with no proxy in front of it.
BOARD_HOST=127.0.0.1

# Host names the board will answer to. REQUIRED behind a proxy.
#
# src/board/server.ts refuses any request whose Host header it does not recognise — that is what
# stops DNS rebinding, and it knows only 127.0.0.1, localhost, ::1 and 0.0.0.0 out of the box.
# Caddy passes the client's Host through unchanged, so a request to https://board.example.com
# arrives at the board as `Host: board.example.com` and gets a 403 {"error":"unrecognised Host"}
# until that name is listed here. Comma-separated. Set it to the same value as BOARD_DOMAIN in
# deploy/caddy.env; bootstrap.sh does this for you.
BOARD_HOSTS=board.example.com

# ---- who may drive it ---------------------------------------------------------------------------
# The page is public to read: the feed, the ribbon and the track record need no password. The four
# verbs that move money — pause, resume, close a position, edit a rule — do, and this is the gate:
# a scrypt hash of the operator's password, checked by the application, which also withholds the
# operator's positions and P&L from everyone who is not signed in.
#
# Generate it with `assay password`. It reads the password on stdin and prints only the hash:
#
#   printf 'your password' | docker compose -f compose.prod.yaml run --rm --no-deps -T board password
#
# Empty means nobody can sign in and the controls are unreachable from the page. That is the safe
# way to be misconfigured, and it is the default. bootstrap.sh fills this in on a first run.
BOARD_ADMIN_PASSWORD_HASH=

# Belt and braces: refuse those four verbs even for a signed-in operator, and hide them on the
# page. For a box that is only ever a display. Control it from a loopback board over
# `ssh -N -L 4663:127.0.0.1:4663` instead.
# BOARD_READONLY=1

# Node's own switch. Keep it at production.
NODE_ENV=production

# Where positions.json is written. /data in the container (a named volume);
# /var/lib/assay under systemd. assay.service sets this itself.
ASSAY_DATA=/data
