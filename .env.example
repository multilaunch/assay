# ---- network -------------------------------------------------------------------------------
# Empty = built-in public pair: publicnode for state (fast, no eth_getLogs) + official RPC for logs
# (strict limits). Or your own, comma-separated, best first; append #nologs to one that refuses getLogs.
RPC_URL=
# Launch detection by subscription. Empty = publicnode's free websocket. "off" = HTTP polling only.
RPC_WS_URL=
POLL_MS=300
# Gate for the public endpoints. Raise / lower on a private provider.
RPC_MAX_IN_FLIGHT=3
RPC_SPACING_MS=50
RPC_LOGS_SPACING_MS=400

# ---- wallet (live trades only; never needed for doctor / hunt / scan / dry run) --------------
PRIVATE_KEY=

# ---- entry defaults --------------------------------------------------------------------------
ENTRY_ETH=0.01
SLIPPAGE_BPS=300
# Do not buy while the opening tax for *your* wallet is above this. 9900 at t=0, ~0 after snipeTaxSeconds.
MAX_OPENING_TAX_BPS=300
MAX_OPEN_POSITIONS=3
# Total ETH entries may consume in one session, whatever the scores say.
SESSION_BUDGET_ETH=0.05

# ---- exits -----------------------------------------------------------------------------------
TAKE_PROFIT_PCT=80
STOP_LOSS_PCT=35
TRAILING_PCT=25
MAX_HOLD_MIN=45

# ---- alerts (optional) -----------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- board -----------------------------------------------------------------------------------
BOARD_PORT=4663
